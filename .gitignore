# Dependencies — regenerated with `npm install` from package-lock.json
node_modules/

# Build output — regenerated by electron-builder; the .exe goes on a GitHub Release, not in the repo
dist/
out/
build/

# electron-builder generated config dumps (contain local machine paths)
builder-debug.yml
builder-effective-config.yaml

# Secrets / environment — never commit
.env
.env.*
*.local

# Logs
*.log
npm-debug.log*

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
